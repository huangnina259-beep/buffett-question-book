      "semantic_review": "not_performed",
      "audio_checked": false
    },
    {
      "text_as_received": "And America â corporate America â fought back like you cannot believe. I mean, it was like World War III had broken out, in terms of armies of CEOs marching on Washington.",
      "publisher_attributes": {
        "data-speaker": "",
        "class": ""
      },
      "id": "cnbc-meeting-2010-afternoon-ch17-p014",
      "paragraph_index": 14,
      "reading_text": "And America — corporate America — fought back like you cannot believe. I mean, it was like World War III had broken out, in terms of armies of CEOs marching on Washington.",
      "reversible_encoding_repairs": [
        {
          "before": "â",
          "after": "—",
          "roundtrip_codec": "latin-1"
        },
        {
          "before": "â",
