      },
      "semantic_review": "not_performed",
      "audio_checked": false
    },
    {
      "text_as_received": "It comes from subconscious poor cognition that justifies a lot of behavior that's really not justifiable if it's better understood. And that happens to practically everybody.",
      "publisher_attributes": {
        "data-speaker": "",
        "class": ""
      },
      "id": "cnbc-meeting-2010-afternoon-ch17-p030",
      "paragraph_index": 30,
      "reading_text": "It comes from subconscious poor cognition that justifies a lot of behavior that's really not justifiable if it's better understood. And that happens to practically everybody.",
