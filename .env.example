# No credentials belong in this example or in client-side code.
# Keep live generation disabled until the provider has passed compatibility,
# quality, latency and cost checks. Curated answers need no model request.
GENERATION_ENABLED=false
MODEL_PROVIDER_NAME=MarsAPI
# Set the provider's documented inference base URL, not its console URL.
MODEL_BASE_URL=https://openapi.wtsht.cn/v1
# Supported adapter choices: chat-completions or responses.
MODEL_PROTOCOL=chat-completions
MODEL_API_KEY=
MODEL_NAME=
# A live provider configuration also needs an explicit positive daily limit.
MODEL_DAILY_REQUEST_LIMIT=0
