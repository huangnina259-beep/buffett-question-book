    },
    {
      "text_as_received": "One of your three key questions is, does management love what they do or does management love the money? So how do you see the crisis having changed integrity of management?",
      "publisher_attributes": {
        "data-speaker": "",
        "class": ""
      },
      "id": "cnbc-meeting-2010-afternoon-ch17-p004",
      "paragraph_index": 4,
